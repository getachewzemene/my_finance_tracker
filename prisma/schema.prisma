// Simple PostgreSQL schema — one table. Kept minimal on purpose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id           Int      @id @default(autoincrement())
  telegramId   String   // Telegram user id, keeps each user's data separate
  type         String
  amount       Decimal  @db.Decimal(14, 2)
  currencyCode String   @default("ETB") @db.Char(3)
  category     String   @default("Other") @db.VarChar(32)
  reason       String   // short note: "salary", "groceries", "Kasma Shop sale", etc.
  createdAt    DateTime @default(now())
  sale         Sale?

  @@index([telegramId])
  @@index([telegramId, createdAt])
}

model Budget {
  id             Int      @id @default(autoincrement())
  telegramId     String
  category       String   @db.VarChar(32)
  monthlyLimit   Decimal  @db.Decimal(14, 2)
  alerted80Month String?
  alerted100Month String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([telegramId, category])
}

model Product {
  id         Int      @id @default(autoincrement())
  telegramId String
  name       String   @db.VarChar(100)
  quantity   Int      @default(0)
  unitCost   Decimal? @db.Decimal(14, 2)
  unitPrice  Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sales      Sale[]

  @@unique([telegramId, name])
  @@index([telegramId])
}

model Sale {
  id         Int      @id @default(autoincrement())
  telegramId String
  productId  Int
  transactionId Int   @unique
  quantity   Int
  unitCost   Decimal  @db.Decimal(14, 2)
  unitPrice  Decimal  @db.Decimal(14, 2)
  total      Decimal  @db.Decimal(14, 2)
  costTotal  Decimal  @db.Decimal(14, 2)
  profit     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([telegramId, createdAt])
  @@index([productId])
}
