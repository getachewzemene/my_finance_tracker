# Copy this file to .env and fill in your values

# From @BotFather
BOT_TOKEN=123456789:your-telegram-bot-token

# Public HTTPS URL where this server is deployed (Telegram Mini Apps require HTTPS).
# During local dev, use a tunnel (e.g. ngrok) and put its https URL here.
WEBAPP_URL=https://your-domain.example.com

# Local SQLite file, no external DB needed
DATABASE_URL="file:./dev.db"

PORT=3000

# How long a Mini App session's initData stays valid, in seconds.
# Default 86400 = 24 hours; lower this for a stricter session lifetime.
INIT_DATA_MAX_AGE_SECONDS=86400
